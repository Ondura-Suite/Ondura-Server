#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd ondura >/dev/null; then
        adduser --system --group --home /var/lib/ondura-server --no-create-home --gecos "Ondura Server" ondura
    fi
    install -d -o ondura -g ondura -m 0750 /var/lib/ondura-server
    install -d -o root -g ondura -m 0750 /etc/ondura-server
    install -d -o root -g ondura -m 0750 /etc/ondura-server/tls
    if [ ! -f /etc/ondura-server/config.toml ]; then
        host="$(hostname -f 2>/dev/null || hostname)"
        case "$host" in *.*) ;; *) host="mail.example.com" ;; esac
        /usr/bin/ondura-server --config /etc/ondura-server/config.toml init --hostname "$host" >/dev/null
        # Certificates are expected in /etc/ondura-server/tls (see the certbot hook).
        sed -i "s|^cert = .*|cert = \"/etc/ondura-server/tls/fullchain.pem\"|; s|^key = .*|key = \"/etc/ondura-server/tls/privkey.pem\"|" /etc/ondura-server/config.toml
        chown root:ondura /etc/ondura-server/config.toml
        chmod 0640 /etc/ondura-server/config.toml
        echo "Ondura Server: edit /etc/ondura-server/config.toml, then see /usr/share/doc/ondura-server/admin.md"
    fi

    # PostgreSQL is the default backend: provision a local role and database
    # (idempotent). The service builds the schema on first start, as the
    # 'ondura' user over the local socket (peer authentication). If PostgreSQL
    # is not reachable, fall back to a clear hint instead of failing the install.
    if command -v runuser >/dev/null 2>&1 && runuser -u postgres -- psql -Atqc 'SELECT 1' >/dev/null 2>&1; then
        runuser -u postgres -- psql -v ON_ERROR_STOP=1 -q <<'SQL' || echo "Ondura Server: could not provision PostgreSQL automatically; run 'ondura-server setup-postgres' as root."
DO $$ BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'ondura') THEN
    CREATE ROLE ondura LOGIN;
  END IF;
END $$;
SELECT 'CREATE DATABASE ondura OWNER ondura'
  WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'ondura')\gexec
SQL
    else
        echo "Ondura Server: PostgreSQL not reachable during install. Once it is running, provision it with: ondura-server setup-postgres"
        echo "               Or switch to the SQLite fallback by setting backend = \"sqlite\" in /etc/ondura-server/config.toml."
    fi
fi

#DEBHELPER#
